%%=================================================================
%% State Machine - Character Exchange
%% RPG Character Sheet Application (target v1.2)
%% Two concurrent regions inside one composite "context" state,
%% separated by a "--" line (documented Mermaid concurrency syntax):
%%   Region A - Modal (UI) lifecycle (frontend).
%%   Region B - Share token lifecycle (backend).
%% White background for GitHub light/dark themes.
%%=================================================================
%%{init: {"theme": "base", "themeVariables": { "background": "#ffffff", "mainBkg": "#ffffff", "primaryColor": "#ffffff", "nodeBorder": "#555555", "lineColor": "#444444" } } }%%
stateDiagram-v2

  state "CharacterExchange Orchestration" as context {

    %% ---------- Region A: Modal (UI) lifecycle ----------
    [*] --> Modal_Closed

    state "Modal_Closed" as Modal_Closed

    Modal_Closed --> Modal_Opening : click "Exchange"
    Modal_Opening --> Modal_Ready : link + summary loaded

    state "Modal_Ready" as Modal_Ready {
      Modal_Ready --> Modal_Copied : click "Copy"
      Modal_Copied --> Modal_Ready : "Copied!" feedback
      Modal_Ready --> Modal_Regenerating : click "Regenerate"
      Modal_Regenerating --> Modal_Ready : new link, old revoked
      Modal_Ready --> Modal_Importing : click "Load" (valid URL)
      Modal_Importing --> Modal_Imported : character fetched
      Modal_Importing --> Modal_Ready : import failed (inline error)
      Modal_Imported --> Modal_Ready : rendered; modal stays open
    }

    Modal_Ready --> Modal_Closed : click "Close"/"X" (no import in progress)
    Modal_Ready --> Modal_Closed : import aborted
    Modal_Importing --> Modal_Closed : import completed or aborted
    Modal_Closed --> [*] : modal destroyed

    --
    %% ---------- Region B: Share token lifecycle ----------
    %% Region B is deliberately declared below the "--" so Mermaid
    %% treats the two regions as concurrent states.

    [*] --> Token_Created

    state "Token_Created" as Token_Created
    state "Token_Active" as Token_Active
    state "Token_Revoked" as Token_Revoked

    Token_Created --> Token_Active : token persisted in LinkStore
    Token_Active --> Token_Revoked : regenerate issued (old token)
    Token_Active : GET /s/{token} -> 302 /characters/{id}
    Token_Revoked : GET /s/{token} -> 410 Gone
    Token_Revoked --> [*] : row purged / superseded
  }