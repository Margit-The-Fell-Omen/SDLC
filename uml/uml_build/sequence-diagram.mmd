%%=================================================================
%% Sequence Diagram - Character Exchange
%% RPG Character Sheet Application (target v1.2)
%% Two flows (no alt fragments; conditional outcomes are drawn as
%% arrows fanning out from the single decision point IC):
%%   Flow A (happy path): open modal + load link / copy.
%%   Flow B (import): paste URL -> validate -> resolve -> outcome.
%% White background for GitHub light/dark themes.
%%=================================================================
%%{init: {"theme": "base", "themeVariables": { "background": "#ffffff", "actorBkg": "#ffffff", "noteBkgColor": "#ffffff", "actorBorder": "#555555", "lineColor": "#444444" }, "themeCSS": ".actor-line{stroke:#000000 !important;stroke-dasharray:4 4 !important;}" } } }%%
sequenceDiagram

  %% ---- Notation guide (comments; Mermaid can't color per-text) ----
  %% Actor: external entity (Player) interacting with the system.
  %% Lifeline: a participant over time.
  %% Synchronous message: solid arrow ->> ; return: dashed arrow -->> .
  %% Branching: several arrows leave the same decision point.
  %% Lifeline termination: "destroy" marks an X at the end of the line.

  actor P as Player
  participant M as CharacterExchangeModal
  participant SLM as ShareLinkManager
  participant IC as ImportController
  participant SLS as ShareLinkService
  participant LS as LinkStore

  %% ========== Flow A - open modal, load link, copy ==========
  P->>M: click "Exchange"
  M->>SLM: requestActiveLink(characterId)
  SLM->>SLS: POST /characters/{id}/share-link
  SLS->>LS: getOrCreateActiveToken(characterId)
  LS-->>SLS: token
  SLS-->>SLM: url + token
  SLM-->>M: url + summary
  M-->>P: show modal (link readonly + summary)

  P->>M: click "Copy"
  M->>SLM: copyToClipboard(url)
  SLM->>SLM: navigator.clipboard.writeText(url)
  SLM-->>M: copied
  M-->>P: "Copied!" feedback

  %% ========== Flow B - import character ==========
  %% Decision point: IC returns one of three outcomes below, all
  %% drawn from the same point (no alt/else fragments).
  P->>M: paste URL, click "Load"
  M->>IC: POST /characters/import {url}
  IC->>SLS: resolveToken(url)
  SLS->>LS: lookup(token_hash)
  LS-->>SLS: character_id | null

  IC-->>M: 200 {character} (URL valid, token active)
  M-->>P: render imported character

  IC-->>M: 410 Gone (token revoked / unknown)
  M-->>P: inline error "Link expired"

  IC-->>M: 400 Bad Request (URL not on whitelist)
  M-->>P: inline error "Invalid URL"

  %% ========== Lifeline termination ==========
  %% Vertical lifelines end with an X cross at the bottom of the
  %% diagram instead of recurring label blocks.
  destroy P
  destroy M
  destroy SLM
  destroy IC
  destroy SLS
  destroy LS